# ════════════════════════════════════════════════════════════════════════════
#  DocIntel v4  —  .env
#  Copy this file to .env, fill in every value, then run:
#    docker compose up --build
# ════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
#  1.  JWT  (Authentication)
# ─────────────────────────────────────────────────────────────────────────────
#  Generate a strong secret key:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
JWT_SECRET_KEY=a3f8c21d94e7b05612084f3a9e1d7c4b8a2f6e0d3c9b5a7d4f1e8c2b6a0d9f3e
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480     # 8 hours — change to 60 for tighter sessions


# ─────────────────────────────────────────────────────────────────────────────
#  2.  PostgreSQL + pgvector
# ─────────────────────────────────────────────────────────────────────────────
#  Docker Compose sets these automatically.
#  Change ONLY if you are using an external Postgres instance.
#
DATABASE_URL=postgresql://docintel:docintel_secret@postgres:5432/docintel

#  If running locally without Docker, point to localhost:
#  DATABASE_URL=postgresql://docintel:docintel_secret@localhost:5432/docintel


# ─────────────────────────────────────────────────────────────────────────────
#  3.  Google Cloud Storage
# ─────────────────────────────────────────────────────────────────────────────
#  Create a bucket in Google Cloud Console:
#    https://console.cloud.google.com/storage/browser
#  Recommended settings:
#    - Region: choose closest to your users
#    - Storage class: Standard
#    - Public access: Uniform, NOT public (all access via signed URLs)
#
GCS_BUCKET_NAME=docintel-documents

#  Service account key — choose ONE option:
#
#  OPTION A (recommended for local dev / Docker):
#    1. Google Cloud Console → IAM → Service Accounts → Create
#    2. Grant roles: Storage Object Admin
#    3. Keys tab → Add Key → JSON → download
#    4. Save as gcs-key.json in the project root
#
GCS_SERVICE_ACCOUNT_KEY_PATH=./gcs-key.json

#  OPTION B (recommended for cloud deployment — no file needed):
#    Paste the entire gcs-key.json content as a single line below
#    (replace newlines with \n inside the private_key field)
#
# GCS_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"your-project","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"docintel@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/docintel%40your-project.iam.gserviceaccount.com"}

#  How long a "View Source" signed URL is valid (seconds)
GCS_SIGNED_URL_EXPIRY_SECONDS=3600      # 1 hour


# ─────────────────────────────────────────────────────────────────────────────
#  4.  LLM Provider  —  choose ONE: openai  |  gemini
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai


# ── OpenAI  (used when LLM_PROVIDER=openai) ───────────────────────────────────
#  Get API key: https://platform.openai.com/api-keys
#  Free $5 credit on new accounts; then pay-as-you-go.
#
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  Embedding model options:
#    text-embedding-3-small  →  1536 dims  — $0.02 / 1M tokens  (recommended)
#    text-embedding-3-large  →  3072 dims  — $0.13 / 1M tokens  (higher quality)
#    text-embedding-ada-002  →  1536 dims  — $0.10 / 1M tokens  (legacy)
OPENAI_EMBED_MODEL=text-embedding-3-small

#  Chat model options:
#    gpt-4o-mini  — fast, cheap: $0.15 input / $0.60 output per 1M tokens
#    gpt-4o       — best quality: $5.00 input / $15.00 output per 1M tokens
OPENAI_CHAT_MODEL=gpt-4o-mini


# ── Google Gemini  (used when LLM_PROVIDER=gemini) ────────────────────────────
#  Get API key (free tier available): https://aistudio.google.com → Get API key
#  No billing required for free tier (limited RPM).
#
GOOGLE_AI_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  Embedding model: text-embedding-004  →  768 dims  (free tier)
GEMINI_EMBED_MODEL=models/text-embedding-004

#  Chat model options:
#    gemini-1.5-flash  — fast, free tier:  cheap, good quality
#    gemini-1.5-pro    — best quality:     higher cost
GEMINI_CHAT_MODEL=gemini-1.5-flash


# ─────────────────────────────────────────────────────────────────────────────
#  5.  Embedding dimension
# ─────────────────────────────────────────────────────────────────────────────
#  MUST match the embedding model above:
#    text-embedding-3-small  →  1536
#    text-embedding-3-large  →  3072
#    text-embedding-ada-002  →  1536
#    text-embedding-004      →   768
#
#  ⚠ Changing this after documents are indexed requires:
#     1. docker compose down -v      (wipe the database)
#     2. Re-upload and re-embed all documents
#
EMBEDDING_DIM=1536


# ─────────────────────────────────────────────────────────────────────────────
#  6.  RAG tuning
# ─────────────────────────────────────────────────────────────────────────────
#  CHUNK_SIZE     — target words per chunk. Larger = more context per chunk,
#                   less precision. Smaller = more precise, more chunks.
CHUNK_SIZE=350

#  CHUNK_OVERLAP  — words shared between consecutive chunks so context
#                   spanning a boundary is still retrievable.
CHUNK_OVERLAP=60

#  TOP_K          — how many similar chunks to retrieve per question.
#                   More = richer context but higher token cost.
TOP_K=6


# ─────────────────────────────────────────────────────────────────────────────
#  7.  Upload limits
# ─────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_FILES=10          # max documents per user
MAX_FILE_SIZE_MB=50          # max size per file


# ─────────────────────────────────────────────────────────────────────────────
#  8.  Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000